{
  "name": "gsoc-org-explorer",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "prepare:data": "node scripts/prepare-data.mjs",
    "refresh:code-links": "node scripts/refresh-project-code-urls.mjs",
    "cache:logos": "npm run prepare:data && node scripts/cache-logo-assets.mjs && npm run prepare:data",
    "build": "npm run prepare:data && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate": "node scripts/validate-data.mjs && node scripts/validate-repository-links.mjs",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name gsoc-organizations --branch main"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "astro": "^5.16.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=20.11"
  }
}
